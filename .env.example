# Copy to .env — see env.template for production notes

DB_TYPE=sqlite

DB_HOST=localhost
DB_NAME=itguy_db
DB_USER=root
DB_PASSWORD=password123

# Firebase Cloud Messaging (optional). Leave unset to disable push.
# Do not commit the service account JSON. Use one of:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# FIREBASE_SERVICE_ACCOUNT_PATH=/home/itguy/secrets/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/home/itguy/secrets/firebase-service-account.json
